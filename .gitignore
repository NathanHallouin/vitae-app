node_modules/
dist/
build/
*.tsbuildinfo
.env*.local
.DS_Store

# Expo : projets natifs et types engendrés, tous reconstruits par la commande
.expo/
expo-env.d.ts
apps/app/ios/
apps/app/android/

# Fichiers écrits par `bun run generate`
apps/app/public/sitemap.xml
apps/app/public/robots.txt
apps/app/public/manifest.json
apps/app/public/og.png
apps/app/public/og/
apps/app/public/photos/
apps/app/public/icone-*.png
apps/app/public/apple-touch-icon.png
apps/app/public/polices/
apps/app/assets/polices/
apps/app/assets/*.png

# Les permissions accordées aux agents sont locales à la machine, comme le dit leur suffixe. Les
# suivre dans le dépôt les faisait s'accumuler sans que personne ne les relise — cinquante-trois
# entrées, dont trente-six commandes jetables — et une liste que personne ne relit est une liste où
# une entrée dangereuse passe inaperçue.
.claude/settings.local.json

# Paquets de passation déposés à la racine le temps d'une refonte : des maquettes et des fichiers
# de référence, pas du code du projet. Les ignorer les tient aussi hors de Biome, qui suit ce
# fichier — sans quoi `bun run check` échouerait sur du code qui n'a jamais été destiné à tourner.
design_handoff_*/

# Signature d'applications : ne doit jamais entrer dans le dépôt
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Export natif de vérification (CI et local)
apps/app/.export-natif/

# Planche-contact des photos : artefact de tri, pas une source
photos/planche.html

# Les originaux des photos de recettes : 161 Mo qui se re-téléchargent à
# lidentique depuis photos/sources.json. Le choix est versionné, pas les octets.
photos/*.jpg
photos/*.jpeg
photos/*.png
